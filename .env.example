# Every Contxt setting, with what it does. `uv run contxt setup` writes the .env you need, so
# copying this file is only for changing something it did not set. Paths count from the
# folder that holds the .env. Never commit .env: it can hold your owner token.
# (The earlier names, WORKSPACE_<NAME>, are still read.)

# --- This Contxt
CONTXT_NAME=Contxt
# IANA timezone for schedules, such as America/Denver. First-time setup asks for it too.
CONTXT_TIMEZONE=UTC

# --- Sign-in
# The owner token signs you in to the web app and manages connections. Generate one with
#   uv run contxt token --new     (Docker: docker compose run --rm app contxt token --new)
# Left empty, one is generated into the data folder and shown by `contxt token`.
CONTXT_OWNER_TOKEN=

# --- Where things live (local runs; Docker uses its named volume)
# The Brain: the folder with brain.json. setup makes brain/vault; empty finds it there.
CONTXT_BRAIN_VAULT=
# The app's database, uploaded files, sign-in key and backups.
CONTXT_DATA_DIR=data
# What your AI makes through the app (skill runs, exports). Empty: outputs/ when it exists.
CONTXT_EXPORTS_DIR=
# SQLite in the data folder by default. For PostgreSQL:
#   postgresql+psycopg://user:password@host:5432/contxt
CONTXT_DATABASE_URL=

# --- Local models (nothing downloads on its own: `uv run contxt models --download`)
# Match context by meaning with the Brain's local model. 0 matches by words alone.
CONTXT_BRAIN_EMBEDDINGS=1
# Where the speech model lives (about 480 MB). Empty: beside the Brain's embedding model.
CONTXT_SPEECH_MODELS=

# --- Network
CONTXT_HOST=127.0.0.1
CONTXT_PORT=8787
# The address models and the browser use, when it differs from host and port.
CONTXT_PUBLIC_URL=
# Extra browser origins allowed to call /mcp (comma separated).
CONTXT_ALLOWED_ORIGINS=
# Behind a TLS reverse proxy (private-server profile): trust its forwarded headers.
CONTXT_TRUST_PROXY=0

# --- The app's AI work
# Default claim lease for a model's run, in seconds.
CONTXT_LEASE_SECONDS=900
# How often the worker expires leases and hands waiting work to a model, in seconds.
CONTXT_WORKER_INTERVAL=15

# --- Docker
# The Brain *folder* on this machine (the one that contains vault/), and where outputs go.
BRAIN_HOST_DIR=
EXPORTS_HOST_DIR=
# The user the containers run as. The folders above must be writable by it. On Linux, set
# both to the folders' owner, usually you: `id -u` and `id -g` (often 1000). Empty means
# 10001, which suits Docker Desktop on Windows and macOS.
CONTXT_UID=
CONTXT_GID=

# --- Private-server profile (docker/compose.server.yaml)
CONTXT_DOMAIN=
POSTGRES_PASSWORD=
